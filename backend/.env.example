# Bind address used by `uvicorn autojev.main:app`.
AUTOJEV_HOST=127.0.0.1
AUTOJEV_PORT=8000

# Files created by AutoJev (SQLite database, screenshots and reports).
AUTOJEV_DATA_DIR=./data

# Recommended in production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When omitted, AutoJev creates a local 0600 key in AUTOJEV_DATA_DIR/.master_key.
AUTOJEV_SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
AUTOJEV_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser defaults.
AUTOJEV_HEADLESS=true
# chromium/firefox/webkit use Playwright-managed browsers. `chrome` and `msedge`
# use installed Playwright channels when available.
AUTOJEV_BROWSER=chromium
AUTOJEV_HTTP_TIMEOUT_SECONDS=45
